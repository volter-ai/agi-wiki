{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wikichat-community",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {"ip":"127.0.0.1","port":4318},
  "assets": {"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "vars": {"MODE":"production","PUBLIC_ORIGIN":"https://replace-with-your-community-domain.example","REVIEW_MODEL":"gpt-5.4-mini"},
  "d1_databases": [{"binding":"DB","database_name":"wikichat-community","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"ARTICLES","bucket_name":"wikichat-community-articles"}],
  "triggers": {"crons":["*/5 * * * *"]}
}
