{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server",
    "test",
    "vendor/siwc/src",
    "shared",
    "community/*.ts",
    "github"
  ]
}
